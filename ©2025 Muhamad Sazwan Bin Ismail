        // ============================================================
        // LEDGER BIG DATA (1500 transaksi)
        // ============================================================
        let ledgerData = [];
        let ledgerPage = 1;
        const perPage = 50;

        function generateLedger() {
            const statuses = ['✅ Selesai', '⏳ Diproses', '🔄 Dihantar', '❌ Gagal'];
            const senders = ['Muhamad Sazwan', 'End AI Global', 'Sazwan Digital', 'MyIPO', 'Bank Negara', 'INTERPOL',
                'NATO', 'ASEAN'
            ];
            const receivers = ['Sovereign Ledger', 'Govt Malaysia', 'AI Fund', 'Cyber Security', 'Blockchain Hub',
                'End AI Global', 'Sazwan Digital'
            ];
            for (let i = 0; i < 1500; i++) {
                const amount = (Math.random() * 95000 + 5000).toFixed(2);
                ledgerData.push({
                    id: i + 1,
                    tx: `TX-${String(1000000 + i).padStart(7, '0')}`,
                    amount: amount,
                    sender: senders[Math.floor(Math.random() * senders.length)],
                    receiver: receivers[Math.floor(Math.random() * receivers.length)],
                    status: statuses[Math.floor(Math.random() * statuses.length)],
                    time: new Date(Date.now() - Math.random() * 30 * 24 * 60 * 60 * 1000).toLocaleString()
                });
            }
            document.getElementById('ledgerCount').innerText = ledgerData.length;
            document.getElementById('totalTx').innerText = ledgerData.length;
        }

        function renderLedger(page = 1) {
            ledgerPage = page;
            const search = document.getElementById('ledgerSearch').value.toLowerCase();
            let filtered = ledgerData;
            if (search) {
                filtered = ledgerData.filter(row =>
                    row.tx.toLowerCase().includes(search) ||
                    row.amount.includes(search) ||
                    row.sender.toLowerCase().includes(search) ||
                    row.receiver.toLowerCase().includes(search) ||
                    row.status.toLowerCase().includes(search)
                );
            }
            const totalPages = Math.ceil(filtered.length / perPage);
            if (ledgerPage > totalPages) ledgerPage = totalPages || 1;
            const start = (ledgerPage - 1) * perPage;
            const pageData = filtered.slice(start, start + perPage);
            const tbody = document.getElementById('ledgerBody');
            tbody.innerHTML = '';
            pageData.forEach(row => {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${row.id}</td><td>${row.tx}</td><td>$${row.amount}</td><td>${row.sender}</td><td>${row.receiver}</td><td>${row.status}</td><td>${row.time}</td>`;
                tbody.appendChild(tr);
            });
            document.getElementById('ledgerPageInfo').innerText =
                `Halaman ${ledgerPage} / ${totalPages || 1}`;
        }

        function changeLedgerPage(delta) {
            const search = document.getElementById('ledgerSearch').value.toLowerCase();
